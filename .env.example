# ============================================================
# SOMA WELLNESS — ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Vite loads this file automatically (frontend).
# Server loads it via server/loadEnv.js (path: ../.env).
# IMPORTANT: .env is gitignored. Never commit real secrets.
# ============================================================

# ── DEVELOPMENT ────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=Soma Wellness
VITE_API_URL=http://localhost:5000

MONGO_URI=
JWT_SECRET=
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d
JWT_REFRESH_SECRET=
REDIS_URL=redis://127.0.0.1:6379
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=hello@somawellness.in
FROM_NAME=Soma Wellness
REPLY_TO=hello@somawellness.in
ADMIN_EMAIL=hello@somawellness.in
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES_PER_CONNECTION=100
SMTP_RATE_DELTA_MS=1000
SMTP_RATE_LIMIT_PER_SECOND=5
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

CHANNEL_TIMEOUT_MS=60000
REQUEST_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=30000
SCHEDULER_TIMEZONE=Africa/Nairobi
LOG_LEVEL=info
REFERRAL_REWARD=500

OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
AT_USERNAME=sandbox
AT_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

SERVER_URL=http://localhost:5000
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/social/success
OAUTH_FAILURE_REDIRECT=http://localhost:5173/login?socialError=1
OAUTH_STATE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:5000/api/mpesa/callback
MPESA_INITIATOR_NAME=soma
MPESA_SECURITY_CREDENTIAL=

WHATSAPP_DEV_MODE=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_PHONE=
WHATSAPP_VERIFY_TOKEN=soma_wellness_verify_2026
WHATSAPP_API_VERSION=v19.0

