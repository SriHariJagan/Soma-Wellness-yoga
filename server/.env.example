# ============================================================
# server/.env.example — copy to server/.env and fill in values.
# NEVER commit the real .env (it is gitignored).
# ============================================================

# Environment
NODE_ENV=development
PORT=5000
APP_NAME=Pragya Yoga Alliance

# Frontend API URL (used by Vite dev server / browser builds)
VITE_API_URL=http://localhost:5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/pragya_yoga

# JWT
JWT_SECRET=change-me-long-random-string
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d
JWT_REFRESH_SECRET=change-me-another-long-random-string

# Razorpay (test credentials until account approval)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Frontend only — Razorpay key exposed to the browser
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Redis (BullMQ queues)
REDIS_URL=redis://127.0.0.1:6379

# CORS / Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=you@gmail.com
FROM_NAME=Pragya Yoga Alliance
REPLY_TO=support@pragyayoga.com

# Admin notification email(s) - comma-separated for multiple recipients (book orders, low stock, bulk enquiries, payments)
ADMIN_EMAIL=admin@pragyayoga.com,secondary@pragyayoga.com

# SMTP connection tuning (optional)
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES_PER_CONNECTION=100
SMTP_RATE_DELTA_MS=1000
SMTP_RATE_LIMIT_PER_SECOND=10
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Legacy SMTP aliases (optional)
EMAIL_FROM=
EMAIL_FROM_NAME=

# Notifications
CHANNEL_TIMEOUT_MS=30000

# Timeouts
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# Scheduler timezone
SCHEDULER_TIMEZONE=Asia/Kolkata

# Referral reward (INR)
REFERRAL_REWARD=100

# Logging
LOG_LEVEL=info