# ============================================================
# server/.env.example — copy to server/.env and fill in values.
# NEVER commit the real .env (it is gitignored).
# ============================================================

# Environment
NODE_ENV=development
PORT=5000
APP_NAME=Soma Wellness

# Frontend API URL (used by Vite dev server / browser builds)
VITE_API_URL=http://localhost:5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/soma_wellness

# JWT
JWT_SECRET=change-me-long-random-string
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d
JWT_REFRESH_SECRET=change-me-another-long-random-string

# Razorpay (test credentials until account approval)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Frontend only — Razorpay key exposed to the browser
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Redis (BullMQ queues)
REDIS_URL=redis://127.0.0.1:6379

# CORS / Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=you@gmail.com
FROM_NAME=Soma Wellness
REPLY_TO=hello@somawellness.co.ke

# Admin notification email(s) - comma-separated for multiple recipients (book orders, low stock, bulk enquiries, payments)
ADMIN_EMAIL=admin@somawellness.co.ke

# SMTP connection tuning (optional)
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES_PER_CONNECTION=100
SMTP_RATE_DELTA_MS=1000
SMTP_RATE_LIMIT_PER_SECOND=10
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Legacy SMTP aliases (optional)
EMAIL_FROM=
EMAIL_FROM_NAME=

# Notifications
CHANNEL_TIMEOUT_MS=30000

# Timeouts
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# Scheduler timezone
SCHEDULER_TIMEZONE=Asia/Kolkata

# Referral reward (KES)
REFERRAL_REWARD=100

# Logging
LOG_LEVEL=info

# ============================================================
# SOCIAL LOGIN (OAuth 2.0 / OpenID Connect)
# ------------------------------------------------------------
# 1. Create credentials at each provider console below.
# 2. Paste the "Authorized redirect URI" EXACTLY as shown
#    (replace YOUR_DOMAIN with SERVER_URL value).
# 3. Fill CLIENT_ID / CLIENT_SECRET here.
# Leave any provider's keys EMPTY to disable that button.
# ============================================================

# Public base URL of THIS API (used to build OAuth callbacks)
# Local dev:  http://localhost:5000   |   Production: https://api.somawellness.co.ke
SERVER_URL=http://localhost:5000

# Where to send the browser AFTER successful / failed social login
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/social/success
OAUTH_FAILURE_REDIRECT=http://localhost:5173/login?socialError=1

# Secret used to sign the OAuth `state` parameter (CSRF protection).
# Use a DIFFERENT random string than JWT_SECRET.
OAUTH_STATE_SECRET=change-me-oauth-state-random-string

# ------------------------------------------------------------
# GOOGLE  ← recommended first
# Console: https://console.cloud.google.com/apis/credentials
#   • Create Credentials → OAuth client ID → Web application
#   • Enable "Google+ API" / People API if prompted
#   • Authorized redirect URI:
#       {SERVER_URL}/api/auth/google/callback
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------
# FACEBOOK (Meta) — also covers INSTAGRAM accounts
# NOTE: Instagram has NO standalone consumer web login.
# Meta's Facebook Login authenticates IG-linked accounts;
# enable it under Products → Facebook Login.
# Console: https://developers.facebook.com/apps
#   • Create App → Consumer type → add "Facebook Login"
#   • Valid OAuth Redirect URIs:
#       {SERVER_URL}/api/auth/facebook/callback
#   • App must be Live (not Dev mode) for public users
# ------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ------------------------------------------------------------
# APPLE SIGN-IN
# Console: https://developer.apple.com/account/resources/identifiers/list
#   • Requires PAID Apple Developer account ($99/yr)
#   • Create Services ID + Sign In with Apple key (.p8)
#   • Return URL:
#       {SERVER_URL}/api/auth/apple/callback
#   • Domain must be verified (apple-developer-domain-association.txt)
#   • Users' email/name arrive ONLY on first sign-in — persist immediately
# ------------------------------------------------------------
APPLE_CLIENT_ID=            # Services ID (e.g. com.somawellness.login)
APPLE_TEAM_ID=              # 10-char Team ID
APPLE_KEY_ID=               # Key ID from the .p8 key
APPLE_PRIVATE_KEY_PATH=     # path to AuthKey_XXXXXX.p8 (or use inline below)
APPLE_PRIVATE_KEY=          # optional: full .p8 contents with \n line breaks

# ------------------------------------------------------------
# X (TWITTER)
# Console: https://developer.x.com/en/portal/dashboard
#   • Project → App → User authentication settings → Read
#   • Callback URI:
#       {SERVER_URL}/api/auth/x/callback
# ------------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=

# ------------------------------------------------------------
# LINKEDIN (OpenID Connect product)
# Console: https://www.linkedin.com/developers/apps
#   • Products → "Sign In with LinkedIn using OpenID Connect"
#   • Redirect URL:
#       {SERVER_URL}/api/auth/linkedin/callback
# ------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ------------------------------------------------------------
# MICROSOFT (Azure AD — personal + work accounts)
# Console: https://portal.azure.com → App registrations
#   • Supported account types: personal + work/school
#   • Web redirect URI:
#       {SERVER_URL}/api/auth/microsoft/callback
# ------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ------------------------------------------------------------
# GITHUB
# Console: https://github.com/settings/developers → New OAuth App
#   • Authorization callback URL:
#       {SERVER_URL}/api/auth/github/callback
# ------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------
# TIKTOK (Login Kit) — optional
# Console: https://developers.tiktok.com/apps
#   • Redirect URI:
#       {SERVER_URL}/api/auth/tiktok/callback
# ------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ============================================================
# PHONE OTP LOGIN (SMS) — strong fit for Kenya
# Pick ONE provider. Used for "+254 7XX XXX XXX + OTP code" login.
# ------------------------------------------------------------

# --- Option A: Africa's Talking (Kenyan, M-Pesa friendly) ---
# Console: https://account.africastalking.com  → Settings → API Key
AT_USERNAME=sandbox           # your username ('sandbox' for testing)
AT_API_KEY=

# --- Option B: Twilio Verify (global) ---
# Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=    # Verify → Services → create one (no sender needed)

# Shared OTP settings
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ============================================================
# WHATSAPP BUSINESS API (Meta Cloud API)
# ------------------------------------------------------------
# Set DEV_MODE=true to log messages to console instead of sending.
# For production, register a Meta Business account and app at
# https://developers.facebook.com/apps/ → WhatsApp → Quickstart.
WHATSAPP_DEV_MODE=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_PHONE=
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_API_VERSION=v19.0

# ============================================================
# M-PESA (Safaricom Daraja API)
# ------------------------------------------------------------
# sandbox = test environment, production = live payments
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_INITIATOR_NAME=soma
MPESA_SECURITY_CREDENTIAL=
MPESA_TIMEOUT=30